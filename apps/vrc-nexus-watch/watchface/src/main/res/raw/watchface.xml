<?xml version="1.0" encoding="utf-8"?>
<!--
  VRC Nexus – Zifferblatt im Watch Face Format 1 (Wear OS 4+), Nexus-Look: dunkel, Cyan/Gold.
  Uhrzeit groß, Sekunden (im Always-On aus), Datum, Puls, Akku-Bogen,
  zwei frei belegbare Felder (Standard: Schritte und Akku – z. B. „App-Verknüpfung → Nexus Watch“ wählen).
-->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:32" />
    <Scene backgroundColor="#ff040609">

        <!-- Außenring -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Arc centerX="225" centerY="225" width="424" height="424" startAngle="0" endAngle="360">
                <Stroke color="#3338d5e6" thickness="5" />
            </Arc>
        </PartDraw>
        <!-- Akku-Bogen rechts (20° … 160°) -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Arc centerX="225" centerY="225" width="424" height="424" startAngle="20" endAngle="160">
                <Stroke color="#ffd6a73e" thickness="5" cap="ROUND" />
                <Transform target="endAngle" value="20 + [BATTERY_PERCENT] * 1.4" />
            </Arc>
        </PartDraw>
        <!-- Zierbogen links -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Arc centerX="225" centerY="225" width="424" height="424" startAngle="200" endAngle="340">
                <Stroke color="#9938d5e6" thickness="5" cap="ROUND" />
            </Arc>
        </PartDraw>

        <!-- Kennung oben -->
        <PartText x="100" y="58" width="250" height="34">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#ff38d5e6" letterSpacing="0.25">
                    <Template>VRC NEXUS</Template>
                </Font>
            </Text>
        </PartText>

        <!-- Datum -->
        <PartText x="75" y="100" width="300" height="36">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="26" weight="NORMAL" color="#ffaab4c4">
                    <Template>%s %s. %s<Parameter expression="[DAY_OF_WEEK_S]" /><Parameter expression="[DAY]" /><Parameter expression="[MONTH_S]" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Uhrzeit -->
        <DigitalClock x="0" y="132" width="450" height="130">
            <TimeText format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER" x="0" y="0" width="450" height="130">
                <Font family="SYNC_TO_DEVICE" size="112" weight="SEMI_BOLD" color="#ffe2e8f0" />
            </TimeText>
        </DigitalClock>
        <!-- Sekunden (im Always-On ausgeblendet) -->
        <DigitalClock x="0" y="258" width="450" height="40">
            <TimeText format="ss" align="CENTER" x="0" y="0" width="450" height="40">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font family="SYNC_TO_DEVICE" size="30" weight="MEDIUM" color="#fff3c262" />
            </TimeText>
        </DigitalClock>

        <!-- Puls -->
        <PartText x="150" y="360" width="150" height="40">
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="30" weight="BOLD" color="#ffff5c6c">
                    <Template>♥ %s<Parameter expression="round([HEART_RATE])" /></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Feld links (Standard: Schritte) -->
        <ComplicationSlot x="52" y="296" width="96" height="96" slotId="0" displayName="Links" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE" isCustomizable="TRUE">
            <DefaultProviderPolicy defaultSystemProvider="STEP_COUNT" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="96" height="96" />
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Arc centerX="48" centerY="48" width="90" height="90" startAngle="0" endAngle="360">
                        <Stroke color="#5538d5e6" thickness="3" />
                    </Arc>
                </PartDraw>
                <PartImage x="33" y="14" width="30" height="30">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="4" y="46" width="88" height="32">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" weight="MEDIUM" color="#ffe2e8f0">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="18" y="18" width="60" height="60">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="23" y="23" width="50" height="50">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>

        <!-- Feld rechts (Standard: Akku) -->
        <ComplicationSlot x="302" y="296" width="96" height="96" slotId="1" displayName="Rechts" supportedTypes="SHORT_TEXT SMALL_IMAGE MONOCHROMATIC_IMAGE" isCustomizable="TRUE">
            <DefaultProviderPolicy defaultSystemProvider="WATCH_BATTERY" defaultSystemProviderType="SHORT_TEXT" />
            <BoundingOval x="0" y="0" width="96" height="96" />
            <Complication type="SHORT_TEXT">
                <PartDraw x="0" y="0" width="96" height="96">
                    <Arc centerX="48" centerY="48" width="90" height="90" startAngle="0" endAngle="360">
                        <Stroke color="#55f3c262" thickness="3" />
                    </Arc>
                </PartDraw>
                <PartImage x="33" y="14" width="30" height="30">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
                <PartText x="4" y="46" width="88" height="32">
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="24" weight="MEDIUM" color="#ffe2e8f0">
                            <Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SMALL_IMAGE">
                <PartImage x="18" y="18" width="60" height="60">
                    <Image resource="[COMPLICATION.SMALL_IMAGE]" />
                </PartImage>
            </Complication>
            <Complication type="MONOCHROMATIC_IMAGE">
                <PartImage x="23" y="23" width="50" height="50">
                    <Image resource="[COMPLICATION.MONOCHROMATIC_IMAGE]" />
                </PartImage>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>
