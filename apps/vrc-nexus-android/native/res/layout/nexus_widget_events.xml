<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/we_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/nexus_widget_bg">
    <TextView android:id="@+id/we_head" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#7A8794" android:textSize="11sp" android:maxLines="1" android:text="📅 Nächste Events" />
    <TextView android:id="@+id/we_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#F3C262" android:textSize="15sp" android:textStyle="bold" android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/we_when" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#38D5E6" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/we_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="#E2E8F0" android:textSize="11sp" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:ellipsize="end" />
    <TextView android:id="@+id/we_foot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#7A8794" android:textSize="10sp" android:gravity="end" />
</LinearLayout>
