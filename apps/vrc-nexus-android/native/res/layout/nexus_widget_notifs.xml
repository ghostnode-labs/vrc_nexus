<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wn_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/nexus_widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/wn_head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F3C262" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="🔔 Benachrichtigungen" />
        <TextView android:id="@+id/wn_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#080D14" android:textSize="12sp" android:textStyle="bold" android:paddingLeft="7dp" android:paddingRight="7dp" android:background="@drawable/nexus_widget_badge" />
    </LinearLayout>
    <TextView android:id="@+id/wn_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:textColor="#E2E8F0" android:textSize="12sp" android:layout_marginTop="6dp" android:lineSpacingExtra="2dp" android:ellipsize="end" />
    <TextView android:id="@+id/wn_foot" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#7A8794" android:textSize="10sp" android:gravity="end" />
</LinearLayout>
